QR_KEY=
QR_ACCOUNT=

# Model credentials stay on the server. Gemini remains the default provider.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted for Gemini.
# GEMINI_MODEL=
OPENROUTER_API_KEY=
# Required for OpenRouter unless every used stage has its own model configured.
OPENROUTER_MODEL=

# Optional models per stage; use the selected provider's prefix.
# OPENROUTER_INTERPRET_MODEL=
# OPENROUTER_RESEARCH_MODEL=
# OPENROUTER_PLAN_MODEL=
# OPENROUTER_BUILD_MODEL=
# OPENROUTER_REVIEW_MODEL=
# OPENROUTER_PLAN_REVIEW_MODEL=
# OPENROUTER_BUILD_REVIEW_MODEL=
# OPENROUTER_SEMANTIC_REVIEW_MODEL=
# OPENROUTER_FINAL_REVIEW_MODEL=
# GEMINI_INTERPRET_MODEL=
# GEMINI_RESEARCH_MODEL=
# GEMINI_PLAN_MODEL=
# GEMINI_BUILD_MODEL=
# GEMINI_REVIEW_MODEL=

# Shared across a pipeline invocation, including nested stages and repairs.
MODEL_MAX_REQUESTS=100
MODEL_MAX_RETRIES=8
MODEL_TIMEOUT_SECONDS=1800
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_OUTPUT_TOKENS=8192
# Optional limits on reported usage. Cost is provider-reported USD.
# MODEL_MAX_TOKENS=
# MODEL_MAX_COST=

# Optional real-map providers. Defaults require no API key for demo use.
# QUANTUM_OSRM_URL=https://router.project-osrm.org
# QUANTUM_GEOCODER_URL=https://photon.komoot.io
# QUANTUM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# QUANTUM_TILE_ATTRIBUTION=© OpenStreetMap contributors
# QUANTUM_MAP_CACHE_DIR=/path/to/quantumloop-map-cache
